{
  "name": "zodziu-tiltai",
  "version": "0.0.0",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.core.json && tsc -p tsconfig.sw.json",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "puzzle:show": "tsx tools/puzzle-show.ts",
    "puzzles:index": "tsx tools/puzzles-index.ts",
    "icons": "tsx tools/icons.ts",
    "generate": "tsx tools/generate.ts",
    "definitions": "tsx tools/definitions.ts",
    "lighthouse": "lhci autorun",
    "wordlists": "tsx tools/build-wordlists.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/satautiv/lt-zanagram.git"
  },
  "bugs": {
    "url": "https://github.com/satautiv/lt-zanagram/issues"
  },
  "homepage": "https://github.com/satautiv/lt-zanagram#readme",
  "private": "true",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "fflate": "0.8.3",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@fontsource/nunito": "^5.3.0"
  }
}
